# Public, host-visible URLs plus a deliberately local-only scheduler token.
# `pnpm db:start` copies this to the ignored `.env` on first use.
DAYPAGE_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
DAYPAGE_MCP_RESOURCE=http://127.0.0.1:54321/functions/v1/daypage-mcp
DAYPAGE_APP_URL=http://127.0.0.1:54321/functions/v1/daypage-oauth
DAYPAGE_OAUTH_CONSENT_URL=http://127.0.0.1:13000/oauth/consent
# Local scheduler credential only. Hosted environments must inject a distinct
# high-entropy value through their server-side secret manager.
DAYPAGE_ATTACHMENT_GC_SECRET=local-daypage-gc-only
