{
  "name": "daypage-mcp-server",
  "version": "0.1.0",
  "description": "OAuth-protected Streamable HTTP MCP server for DayPage",
  "type": "module",
  "bin": {
    "daypage-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:edge": "node scripts/build-edge.mjs",
    "dev": "pnpm build && node --enable-source-maps dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "test:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.108.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.25.10",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
