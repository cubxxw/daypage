{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daypage.app/contracts/sync-push-result-v2.schema.json",
  "title": "DayPage revisioned attachment sync push result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["accepted", "rejected"],
  "properties": {
    "accepted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "memo_id", "revision", "remote_revision", "status", "attachment_manifest_hash"],
        "properties": {
          "operation_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
          "memo_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
          "revision": { "type": "integer", "minimum": 1 },
          "remote_revision": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["applied", "stale"] },
          "attachment_manifest_hash": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "memo_id", "reason"],
        "properties": {
          "operation_id": { "type": ["string", "null"] },
          "memo_id": { "type": ["string", "null"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
