{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daypage.app/contracts/sync-push-result-v1.schema.json",
  "title": "DayPage sync push result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["accepted", "rejected"],
  "properties": {
    "accepted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "memo_id", "revision", "remote_revision", "status"],
        "properties": {
          "operation_id": { "$ref": "#/$defs/uuid" },
          "memo_id": { "$ref": "#/$defs/uuid" },
          "revision": { "type": "integer", "minimum": 1 },
          "remote_revision": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["applied", "stale"] }
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": {
          "operation_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
          "memo_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    }
  }
}
