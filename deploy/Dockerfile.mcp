FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/mcp-server/package.json packages/mcp-server/package.json
RUN pnpm install --frozen-lockfile --filter daypage-mcp-server...

COPY packages/mcp-server packages/mcp-server
RUN pnpm --filter daypage-mcp-server build \
    && pnpm --filter daypage-mcp-server deploy --prod --legacy /out

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /out ./
USER node
EXPOSE 43119
HEALTHCHECK --interval=30s --timeout=5s --retries=5 \
  CMD wget -qO- http://127.0.0.1:43119/healthz >/dev/null || exit 1
CMD ["node", "dist/index.js"]
