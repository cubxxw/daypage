<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>SpaceGrotesk-Light.ttf</string>
		<string>SpaceGrotesk-Regular.ttf</string>
		<string>SpaceGrotesk-Medium.ttf</string>
		<string>SpaceGrotesk-SemiBold.ttf</string>
		<string>SpaceGrotesk-Bold.ttf</string>
		<string>Inter-Light.ttf</string>
		<string>Inter-Regular.ttf</string>
		<string>Inter-Medium.ttf</string>
		<string>Inter-SemiBold.ttf</string>
		<string>Inter-Bold.ttf</string>
		<string>JetBrainsMono-Regular.ttf</string>
		<string>JetBrainsMono-Medium.ttf</string>
		<string>SourceSerif4-Regular.ttf</string>
		<string>SourceSerif4-Medium.ttf</string>
		<string>SourceSerif4-SemiBold.ttf</string>
		<string>SourceSerif4-It.ttf</string>
		<string>SourceHanSerifSC-Regular.otf</string>
		<string>SourceHanSerifSC-Medium.otf</string>
		<string>SourceHanSerifSC-SemiBold.otf</string>
		<string>Fraunces-VariableFont.ttf</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.daypage.daily-compilation</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>DayPage 只在您启动采集时使用相机，以拍摄照片、扫描文档或识别文字。</string>
	<key>NSCalendarsUsageDescription</key>
	<string>只有当您批准一条日历动作时，DayPage 才会为您创建或更新该日程。</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>只有当您批准一条日历动作时，DayPage 才会把该日程写入系统日历。</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>DayPage 仅在您要求检查或撤销已批准的日程时读取相关日历数据。</string>
	<key>NSRemindersUsageDescription</key>
	<string>只有当您批准一条提醒事项动作时，DayPage 才会访问系统提醒事项。</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>DayPage 需要读写您明确批准的提醒事项，以便创建、检查或撤销它。</string>
	<key>NSContactsUsageDescription</key>
	<string>DayPage 优先使用系统联系人选择器；只有当您确认保存联系人时才请求访问。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>DayPage 需要访问麦克风，以便录制语音 memo 并自动转写为文字。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>DayPage 需要使用语音识别，以便在反馈表单中将您的语音输入转写为文字。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>当您选择“保存到相册”时，DayPage 需要添加访问权限来保存这一份 Moment。</string>
	<key>NSHealthShareUsageDescription</key>
	<string>当您主动点按“今日步数摘要”时，DayPage 只在设备上读取所选时间范围内的步数，不会请求写入健康数据。</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>DayPage 需要在后台持续感知您的位置，以自动记录您到访的地点。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>DayPage 需要您的位置来为 memo 添加地点标记。</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>DayPage 需要在您设定的时间点用灵动岛提醒您记录当下（仅 iOS 26 及以上）。</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>location</string>
		<string>processing</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.daypage.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>daypage</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
		</dict>
	</array>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
